# Copy to ignored .env.launch.local. Do not paste any values into chat.
# Create a dedicated free Supabase project named Kin and a personal access token.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Google OAuth client of type Web application, with the Supabase callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DigitalOcean model access key, scoped to Gemma 4.
AI_API_KEY=
AI_PROVIDER=digitalocean
AI_MODEL=gemma-4-31B-it
RECIPIENT_URL=https://ashuujha.github.io/kin
